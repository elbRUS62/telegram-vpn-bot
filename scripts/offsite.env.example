# Backblaze B2 S3 credentials.
# Bucket must be private. Use an application key limited to this bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Example:
# RESTIC_REPOSITORY=s3:https://s3.us-west-004.backblazeb2.com/skrepnet-backups
RESTIC_REPOSITORY=
# Optional: B2 region, for example us-west-004.
AWS_DEFAULT_REGION=

RESTIC_PASSWORD_FILE=/root/.config/skrepnet-offsite/restic-password
RESTIC_CACHE_DIR=/root/.cache/restic

# UptimeRobot heartbeat URLs.
# BACKUP_URL is pinged after a successful offsite backup.
# RESTORE_URL is pinged after a successful restore check (optional).
UPTIMEROBOT_BACKUP_URL=
UPTIMEROBOT_RESTORE_URL=
